{
    "version": 2,
      "headers": [
    {
      "source": "/assets/(.*)",
    }
  ],
    "builds": [
        {
            "src": "index.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "/index.html"
        }
    ]
}
